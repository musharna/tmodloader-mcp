<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>ApiIndex</AssemblyName>
    <RootNamespace>ApiIndex</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reads an assembly's METADATA without loading or running it. That is the
         whole point: tModLoader.dll is a Windows game assembly with a graphics
         stack behind it, and this runs on a build machine that has neither. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>
</Project>
